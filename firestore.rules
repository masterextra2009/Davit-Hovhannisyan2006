rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Essential security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() &&
             (request.auth.uid == 'pRIp0NUg6lSR2ujVhywFkQ5TIW22' ||
              request.auth.uid == 'YbYV6lLNlnVeJ0SKSr3ufzNzNx23' ||
              request.auth.token.email == 'photo-sever@yandex.ru' ||
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               getUserRole() == 'admin'));
    }

    // Промокод-поля защищены от самостоятельной ВЫДАЧИ (клиент не может
    // записать себе новый/больший promoDiscount), но клиенту разрешено
    // самому УДАЛИТЬ свой личный промокод после использования — это
    // легитимный флоу в handlePlaceOrder (torn-paper анимация съедает
    // promoCode/promoDiscount/promoGiftedSeen из профиля клиента).
    function touchesPromoFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['promoCode', 'promoDiscount', 'promoExpiresAt']);
    }
    function onlyRemovingPromoFields() {
      return !('promoCode' in request.resource.data) &&
             !('promoDiscount' in request.resource.data) &&
             !('promoExpiresAt' in request.resource.data);
    }

    // Profile accounts path rules
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId) &&
                    (request.resource.data.role == 'client' ||
                     (request.resource.data.role == 'admin' &&
                      (request.resource.data.email == 'photo-sever@yandex.ru' || userId == 'pRIp0NUg6lSR2ujVhywFkQ5TIW22' || userId == 'YbYV6lLNlnVeJ0SKSr3ufzNzNx23') &&
                      (request.auth.token.email == 'photo-sever@yandex.ru' || userId == 'pRIp0NUg6lSR2ujVhywFkQ5TIW22' || userId == 'YbYV6lLNlnVeJ0SKSr3ufzNzNx23' || !('email' in request.auth.token) || request.auth.token.email == null)));
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) &&
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isAdmin()) &&
                    (isAdmin() || !touchesPromoFields() || onlyRemovingPromoFields());
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    // Print orders path rules — клиент не может через прямую запись в
    // Firestore подделать оплату (paymentStatus/status задаются только при
    // создании и только в безопасных начальных значениях; менять их после
    // создания может только admin или серверный вебхук ЮKassa, который
    // пишет через Admin SDK и не подчиняется этим правилам).
    // Клиенту разрешено после создания трогать только files+totalCost
    // (удаление файла из своего pending/approved заказа и пересчёт суммы,
    // см. handleDeleteFileFromOrder) и rating/ratingComment (оценка
    // выполненного заказа) — остальные поля защищены от подмены.
    match /orders/{orderId} {
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.resource.data.userId == request.auth.uid &&
         request.resource.data.paymentStatus == 'unpaid' &&
         request.resource.data.status == 'pending')
      );
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['files', 'totalCost', 'rating', 'ratingComment']))
      );
      // Клиент может удалить свой собственный заказ, только пока он ещё
      // неоплачен и не взят в обработку (pending) — не даёт скрыть
      // одобренный/оплаченный/печатающийся заказ, чтобы избежать оплаты
      // или спрятать что-то от админа задним числом.
      allow delete: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid &&
         resource.data.paymentStatus == 'unpaid' &&
         resource.data.status == 'pending')
      );
    }

    // Live chat log channels path rules
    match /chatMessages/{chatId} {
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.senderId == request.auth.uid || isAdmin());
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isAdmin();
    }

    // Live alerts target path rules
    match /notifications/{notificationId} {
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Витрина услуг в личном кабинете клиента — читают все вошедшие
    // пользователи, редактирует только админ.
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Счётчик порядковых номеров новых заказов (ORD-1000, ORD-1001, ...) —
    // инкрементируется транзакцией при оформлении заказа любым вошедшим
    // клиентом, поэтому запись нужна всем signed-in, не только админу.
    // Ограничено единственным числовым полем next, чтобы запись не могла
    // подменить документ произвольными данными.
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
                      request.resource.data.keys().hasOnly(['next']) &&
                      request.resource.data.next is number;
    }

    // Публичный счётчик посещений сайта — единственный документ, куда
    // разрешена запись БЕЗ входа в аккаунт (чтобы считать анонимных посетителей).
    // Запись ограничена только полями total/history с числовым total, чтобы
    // анонимный запрос не мог подменить документ произвольными данными.
    // Читать статистику может только администратор.
    match /stats/visits {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['total', 'history']) &&
                       request.resource.data.total is number;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total', 'history']) &&
                       request.resource.data.total is number;
      allow delete: if isAdmin();
    }
  }
}
