rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Essential security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() &&
             (request.auth.uid == 'pRIp0NUg6lSR2ujVhywFkQ5TIW22' ||
              request.auth.uid == 'YbYV6lLNlnVeJ0SKSr3ufzNzNx23' ||
              request.auth.token.email == 'photo-sever@yandex.ru' ||
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               getUserRole() == 'admin'));
    }

    // Промокод-поля защищены от самостоятельной ВЫДАЧИ (клиент не может
    // записать себе новый/больший promoDiscount), но клиенту разрешено
    // самому УДАЛИТЬ свой личный промокод после использования — это
    // легитимный флоу в handlePlaceOrder (torn-paper анимация съедает
    // promoCode/promoDiscount/promoGiftedSeen из профиля клиента).
    function touchesPromoFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['promoCode', 'promoDiscount', 'promoExpiresAt']);
    }
    function onlyRemovingPromoFields() {
      return !('promoCode' in request.resource.data) &&
             !('promoDiscount' in request.resource.data) &&
             !('promoExpiresAt' in request.resource.data);
    }

    // Profile accounts path rules
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      // ВАЖНО: проверка "стать админом" опирается ТОЛЬКО на проверенные сервером
      // значения (request.auth.uid, request.auth.token.email) — никогда на
      // request.resource.data.email, потому что это поле самого документа,
      // которое пишет сам клиент в своём же запросе, и его легко подделать.
      // Раньше здесь ещё был фолбэк "если в токене нет email — разрешить" —
      // это открывало дыру для входа через Telegram (тамошний custom-token не
      // содержит email), позволяя любому телеграм-пользователю выдать себе
      // role:'admin'. Убран целиком.
      allow create: if isSignedIn() && isOwner(userId) &&
                    (request.resource.data.role == 'client' ||
                     (request.resource.data.role == 'admin' &&
                      (userId == 'pRIp0NUg6lSR2ujVhywFkQ5TIW22' ||
                       userId == 'YbYV6lLNlnVeJ0SKSr3ufzNzNx23' ||
                       request.auth.token.email == 'photo-sever@yandex.ru')));
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) &&
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isAdmin()) &&
                    (isAdmin() || !touchesPromoFields() || onlyRemovingPromoFields());
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    // Print orders path rules — клиент не может через прямую запись в
    // Firestore подделать оплату (paymentStatus/status задаются только при
    // создании и только в безопасных начальных значениях; менять их после
    // создания может только admin или серверный вебхук ЮKassa, который
    // пишет через Admin SDK и не подчиняется этим правилам).
    // Клиенту разрешено после создания трогать только files+totalCost
    // (удаление файла из своего pending/approved заказа и пересчёт суммы,
    // см. handleDeleteFileFromOrder) и rating/ratingComment (оценка
    // выполненного заказа) — остальные поля защищены от подмены.
    match /orders/{orderId} {
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.resource.data.userId == request.auth.uid &&
         request.resource.data.paymentStatus == 'unpaid' &&
         request.resource.data.status == 'pending')
      );
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['files', 'totalCost', 'rating', 'ratingComment', 'transactionId']))
      );
      // Клиент может удалить свой собственный заказ, только пока он ещё
      // неоплачен и не взят в обработку (pending) — не даёт скрыть
      // одобренный/оплаченный/печатающийся заказ, чтобы избежать оплаты
      // или спрятать что-то от админа задним числом.
      allow delete: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid &&
         resource.data.paymentStatus == 'unpaid' &&
         resource.data.status == 'pending')
      );
    }

    // Live chat log channels path rules
    match /chatMessages/{chatId} {
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.senderId == request.auth.uid || isAdmin());
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isAdmin();
    }

    // Live alerts target path rules
    match /notifications/{notificationId} {
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // resource == null: клиент авто-чистит уведомления старше 48ч по таймеру
      // (Dashboard.tsx) — при нескольких открытых вкладках/устройствах два
      // сеанса могут одновременно попытаться удалить одно и то же уведомление;
      // без этой ветки повторное удаление уже удалённого документа Firestore
      // трактует как отказ в доступе (resource.data на null падает), хотя
      // по сути результат уже достигнут.
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }

    // Пожелания/замечания от клиентов (форма в личном кабинете) — клиент
    // может только создать своё сообщение, читает и отвечает (через чат)
    // только админ. Ответ идёт не сюда, а в chatMessages — этот документ
    // одноразовый и не редактируется.
    match /feedback/{feedbackId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Витрина услуг в личном кабинете клиента — читают все вошедшие
    // пользователи, редактирует только админ.
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Реферальная программа: код -> id пользователя. Отдельная коллекция
    // (а не query по users.referralCode) специально, чтобы не открывать
    // клиентам чтение чужих профилей — /users/{userId} читает только сам
    // владелец или админ (см. выше), а Firestore не разрешит query по полю
    // users.referralCode, если правило не гарантирует доступ к каждому
    // возможному результату. Здесь же документ не содержит ничего чувствительного
    // (только сам код в id и userId в данных), поэтому читать могут все вошедшие.
    // Создать свою запись может только сам пользователь и только указав
    // СВОЙ ЖЕ userId — не даёт подменить чужой код на свой id и перехватывать
    // чужие переходы по ссылке. Неизменяема после создания.
    match /referralCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid &&
                     request.resource.data.keys().hasOnly(['userId']);
      allow update, delete: if false;
    }

    // Счётчик порядковых номеров новых заказов (ORD-1000, ORD-1001, ...) —
    // инкрементируется транзакцией при оформлении заказа любым вошедшим
    // клиентом, поэтому запись нужна всем signed-in, не только админу.
    // Ограничено единственным числовым полем next, чтобы запись не могла
    // подменить документ произвольными данными.
    // Клиентский код всегда пишет ровно resource.data.next + 1 (транзакция в
    // getNextOrderNumber, firebaseUtils.ts), а при первом обращении — 1001
    // (счётчик стартует с базы 1000). Правило теперь требует именно этого —
    // раньше любой вошедший клиент мог выставить next в произвольное число
    // (сбросить/накрутить нумерацию заказов).
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
                      request.resource.data.keys().hasOnly(['next']) &&
                      request.resource.data.next is number &&
                      ((!exists(/databases/$(database)/documents/counters/$(counterId)) && request.resource.data.next == 1001) ||
                       (exists(/databases/$(database)/documents/counters/$(counterId)) && request.resource.data.next == resource.data.next + 1));
    }

    // Публичный счётчик посещений сайта — единственный документ, куда
    // разрешена запись БЕЗ входа в аккаунт (чтобы считать анонимных посетителей).
    // Запись ограничена только полями total/history с числовым total, чтобы
    // анонимный запрос не мог подменить документ произвольными данными.
    // Читать статистику может только администратор.
    // total должен расти строго на 1 за один write (так и делает trackSiteVisit
    // через increment(1)) — раньше сюда мог написать кто угодно без входа в
    // аккаунт вообще любое число, то есть счётчик посещений накручивался/
    // обнулялся одним произвольным запросом к Firestore напрямую.
    match /stats/visits {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['total', 'history']) &&
                       request.resource.data.total is number &&
                       request.resource.data.total == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total', 'history']) &&
                       request.resource.data.total is number &&
                       request.resource.data.total == resource.data.total + 1;
      allow delete: if isAdmin();
    }
  }
}
