# У этого сайта нет клиентского роутинга по URL — личный кабинет, заказы,
# чат и другие разделы переключаются React-состоянием (activeTab) без
# изменения адреса страницы, а не отдельными путями. Поэтому обычный
# "SPA-фоллбэк на index.html для любого пути" тут не нужен — это и была
# причина того, что несуществующие адреса отдавали 200 вместо 404
# (см. рекомендацию Яндекс.Вебмастера).
#
# Единственный настоящий виртуальный путь — /share-target (Web Share
# Target API из manifest.json): когда файл "расшаривают" в установленное
# PWA-приложение с телефона, браузер шлёт сюда POST. Сервис-воркер
# (public/sw.js) обычно перехватывает этот запрос сам ещё до сервера, но
# на случай, если он ещё не активировался (первый заход после установки),
# сервер должен уметь ответить, а не отдать 404.
RewriteEngine On

# Принудительный переход на HTTPS.
#
# До этого http://sever-18.ru открывался как есть и отдавал 200 — то есть
# сайт реально работал по незащищённому адресу, и всё, что человек вводил
# на такой странице (телефон, пароль), шло по сети открытым текстом.
#
# Условия ниже — не прихоть, а защита от «вечного редиректа». На Beget перед
# Apache стоит nginx: шифрование разбирает nginx, а Apache получает уже
# обычный http-запрос и сам по себе не знает, что посетитель пришёл по https.
# О настоящем протоколе говорит один из служебных признаков ниже — какой
# именно, зависит от настроек хостинга. Все условия соединены по «И»:
# перенаправляем, только если НИ ОДИН из признаков не говорит «это уже https».
# Если бы мы проверяли только %{HTTPS}, а Beget передавал бы признак заголовком,
# сайт зациклился бы: https → Apache видит «http» → снова редирект на https.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{HTTP:X-Forwarded-Protocol} !=https
RewriteCond %{HTTP:X-Forwarded-SSL} !=on
RewriteCond %{HTTP:X-HTTPS} !=1
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

RewriteRule ^share-target$ /index.html [L]

# Всё остальное, чего нет как настоящего файла или папки — честный 404.
# Реферальные ссылки (/?ref=КОД) и ярлыки PWA (/?open=upload) — это путь
# "/" с query-параметрами, сюда не относится, отдаются как есть.
#
# ВАЖНО: путь локальный (/404.html), не полный URL — если указать
# внешний адрес (как в примере из базы знаний Beget), Apache сделает
# редирект (код 302), и настоящий 404 потеряется. Локальный путь
# сохраняет код ответа 404, просто подставляя другую страницу.
ErrorDocument 404 /404.html

# Защитные заголовки ответа. Раньше сервер не отдавал ни одного из них.
# <IfModule> — чтобы сайт не упал с ошибкой 500, если модуль headers
# на хостинге вдруг окажется выключен: тогда блок просто не применится.
#
# always — заголовки нужны и на страницах ошибок (404 и т.п.), обычный
# set их там не выставляет.
<IfModule mod_headers.c>
  # Говорит браузеру целый год ходить на sever-18.ru только по https, даже
  # если человек введёт адрес руками. Намеренно без includeSubDomains и
  # preload: это распространилось бы на все поддомены и в списки самих
  # браузеров, откуда откатить назад практически невозможно.
  Header always set Strict-Transport-Security "max-age=31536000"

  # Запрещает браузеру «угадывать» тип файла вопреки заголовку — приём,
  # которым загруженную картинку заставляют выполниться как скрипт.
  Header always set X-Content-Type-Options "nosniff"

  # Запрещает встраивать сайт в <iframe> на чужом домене (кликджекинг):
  # поверх настоящих кнопок кладут прозрачный слой и жмут за посетителя.
  Header always set X-Frame-Options "SAMEORIGIN"

  # При переходе по внешней ссылке отдаём только домен, без полного адреса
  # страницы и его параметров (например, без ?ref=КОД реферальной ссылки).
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Доступ к железу телефона. camera=(self) — именно self, а НЕ пустые
  # скобки: камеру использует сканер штрих-кодов в админке
  # (navigator.mediaDevices.getUserMedia в Dashboard.tsx), и запрет
  # камеры молча сломал бы сканер. Микрофон и геолокация сайту не нужны.
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
</IfModule>

# Карты исходников (.map) больше не попадают в сборку (см.
# scripts/strip-sourcemaps.mjs), но на сервере могли остаться файлы от
# прошлых выкладок — выкладка по SFTP старое не удаляет. Это запасной
# замок: даже если такой файл лежит на диске, наружу он не отдаётся.
#
# Блок отдельно от mod_headers выше: запрет доступа делает не он.
# Require — синтаксис Apache 2.4, а mod_authz_core есть только в 2.4,
# поэтому <IfModule> заодно страхует от ошибки 500 на старом Apache.
<IfModule mod_authz_core.c>
  <FilesMatch "\.map$">
    Require all denied
  </FilesMatch>
</IfModule>
